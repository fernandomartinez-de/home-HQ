# Supabase project URL (functions live at $SUPABASE_URL/functions/v1/...)
SUPABASE_URL=https://<project-ref>.supabase.co
# The home API key stored in Supabase Vault as 'home_api_key'
HOME_API_KEY=
# Passcode for signing in to the dashboard, and a long random string to sign the session cookie
DASHBOARD_PASSCODE=
SESSION_SECRET=
# Set to 1 to run with sample data and no Supabase connection
HOME_MOCK=0
